# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# Generate with: flask --app wsgi hash-password
ADMIN_PASSWORD_HASH=
# Shop WhatsApp in international format, digits only (Kenya example)
SHOP_WHATSAPP=254700000000
SHOP_NAME=My Cyber & Decor Shop
# Set to 1 on PythonAnywhere (HTTPS) so cookies are Secure
SESSION_COOKIE_SECURE=0
MAX_UPLOAD_MB=25

# Optional: leave empty to use SQLite file shop.db in project root
DATABASE_URL=

# Future payment integration (M-Pesa Daraja) - not used yet
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
