# Copy to .env and replace the example values. NEVER commit .env.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# Generate with: flask --app app hash-password   (paste the printed HASH, not the password)
ADMIN_PASSWORD_HASH=
# Shop WhatsApp number in international format, digits only (Kenya example).
# This is a phone number used to create wa.me links, not an API key.
SHOP_WHATSAPP=254700000000
SHOP_NAME=SwiftPrint
# 1 on PythonAnywhere (HTTPS). Use 0 only when testing locally over http://127.0.0.1
SESSION_COOKIE_SECURE=1

# Upload limits
MAX_UPLOAD_MB=50        # everything in one order, combined
MAX_FILE_MB=25          # one single file
MAX_FILES_PER_ORDER=10

# Optional. Leave empty to use SQLite at backend/shop.db.
DATABASE_URL=
